# Copiez ce fichier en .env (./scripts/init_env.sh le fait et génère les mots de passe)
# PostgreSQL
POSTGRES_DB=appdb
POSTGRES_USER=db_admin
POSTGRES_PASSWORD=change_me
APP_DB_USER=app_user
APP_DB_PASSWORD=change_me
EXPORTER_DB_PASSWORD=change_me
# MongoDB
MONGO_ROOT_USER=mongo_admin
MONGO_ROOT_PASSWORD=change_me
MONGO_APP_DB=appdb
MONGO_APP_USER=app_user
MONGO_APP_PASSWORD=change_me
MONGO_EXPORTER_PASSWORD=change_me
# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
# Sauvegardes : rétention en jours
RETENTION_DAYS=7
